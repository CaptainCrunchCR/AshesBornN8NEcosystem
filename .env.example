# Copy to .env and replace every change-me. Never commit .env; keep a copy in a password manager.
# Generate secrets with: openssl rand -hex 32  (hex is safe inside the connection URLs below)

INCLUDE_PATH=./project

# Image versions (Docker Hub, checked 2026-10-11). Keep n8n and its runner identical.
N8N_VERSION=2.43.3
EVOLUTION_VERSION=v2.3.7
# Postgres 18+ uses a different data directory than this repo mounts.
POSTGRES_VERSION=17.11
REDIS_VERSION=8.10.2
TRAEFIK_VERSION=v3.7.14
PGADMIN_VERSION=9.18.0
REDIS_INSIGHT_VERSION=3.8.0

# Traefik / domains
TRAEFIK_EMAIL=change-me@dialogato.com
TRAEFIK_N8N_SUBDOMAIN=n8n.dialogato.com
TRAEFIK_EVOLUTION_SUBDOMAIN=evolution.dialogato.com

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=n8n
POSTGRES_NON_ROOT_USER=dialogato_app
POSTGRES_NON_ROOT_PASSWORD=change-me
POSTGRES_DIALOGATO_DB=dialogato

# Redis
REDIS_PASSWORD=change-me

# n8n
N8N_ENCRYPTION_KEY=change-me
RUNNERS_AUTH_TOKEN=change-me
N8N_WEBHOOK_URL=https://n8n.dialogato.com/
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=true
GENERIC_TIMEZONE=America/Costa_Rica

# Evolution API (read directly from this file).
# The URLs must repeat the Postgres app user/password and the Redis password above.
EVOLUTION_AUTHENTICATION_KEY=change-me
SERVER_URL=https://evolution.dialogato.com
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://dialogato_app:change-me@postgres:5432/n8n?schema=evolution_api
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://:change-me@redis:6379/6
CACHE_LOCAL_ENABLED=false

# pgAdmin
PGADMIN_DEFAULT_EMAIL=change-me@dialogato.com
PGADMIN_DEFAULT_PASSWORD=change-me

# Off-provider backups (docs/backups.md)
R2_ACCOUNT_ID=change-me
R2_ACCESS_KEY_ID=change-me
R2_SECRET_ACCESS_KEY=change-me
R2_BUCKET=dialogato-backups
BACKUP_HEALTHCHECK_URL=
