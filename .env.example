# Copy to .env and replace every "change-me" value. Never commit .env.
# Keep a copy of the finished .env outside the server (e.g. a password manager):
# without N8N_ENCRYPTION_KEY, stored n8n credentials cannot be decrypted.
#
# Generate secrets with:  openssl rand -hex 32
# Passwords must not contain single quotes, and must be URL-safe because they are
# embedded in connection strings: hex output from the command above is ideal.

# --- Compose -------------------------------------------------------------------
INCLUDE_PATH=./project

# --- Image versions (checked on Docker Hub, 2026-10-10) --------------------------
# Keep N8N_VERSION identical for n8n and its runner image.
N8N_VERSION=2.43.3
EVOLUTION_VERSION=v2.3.7
CLOUDFLARED_VERSION=2026.10.0
# Postgres 18+ uses a different data directory; upgrading needs a migration.
POSTGRES_VERSION=17.11
REDIS_VERSION=8.10.2
PGADMIN_VERSION=9.18.0
REDIS_INSIGHT_VERSION=3.8.0

# --- Public hostnames (routed by the Cloudflare Tunnel) ------------------------
N8N_HOSTNAME=n8n.ashesborn.com
EVOLUTION_HOSTNAME=evolution.ashesborn.com

# --- Cloudflare Tunnel -----------------------------------------------------------
# Zero Trust dashboard > Networks > Tunnels > your tunnel > install command token.
CLOUDFLARE_TUNNEL_TOKEN=change-me

# --- Postgres --------------------------------------------------------------------
POSTGRES_USER=postgres_admin
POSTGRES_PASSWORD=change-me
# n8n's database.
POSTGRES_DB=n8n
# App user shared by n8n, Evolution and Cheeto Bot (see ADR 0005).
POSTGRES_NON_ROOT_USER=ashesborn_app
POSTGRES_NON_ROOT_PASSWORD=change-me
POSTGRES_EVOLUTION_DB=evolution
POSTGRES_CHEETO_BOT_DB=cheeto_bot

# --- Redis -----------------------------------------------------------------------
REDIS_PASSWORD=change-me

# --- n8n -------------------------------------------------------------------------
N8N_ENCRYPTION_KEY=change-me
RUNNERS_AUTH_TOKEN=change-me
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=true
GENERIC_TIMEZONE=America/Costa_Rica
TZ=America/Costa_Rica

# --- Evolution API -----------------------------------------------------------------
# Database and Redis connection strings are built in project/evolution/docker-compose.yml.
EVOLUTION_AUTHENTICATION_KEY=change-me
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=true
DATABASE_CONNECTION_CLIENT_NAME=ashesborn_evolution
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true
DATABASE_SAVE_DATA_LABELS=true
DATABASE_SAVE_DATA_HISTORIC=true
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_REDIS_SAVE_INSTANCES=false
DEL_INSTANCE=false
LOG_LEVEL=ERROR,WARN,INFO
CONFIG_SESSION_PHONE_CLIENT=AshesBorn
CONFIG_SESSION_PHONE_NAME=Chrome
LANGUAGE=en

# --- pgAdmin -----------------------------------------------------------------------
PGADMIN_DEFAULT_EMAIL=admin@ashesborn.com
PGADMIN_DEFAULT_PASSWORD=change-me

# --- Backups to Cloudflare R2 (see ADR 0004) ---------------------------------------
# R2 > Manage API tokens > create a token with Object Read & Write on the bucket only.
R2_ACCOUNT_ID=change-me
R2_ACCESS_KEY_ID=change-me
R2_SECRET_ACCESS_KEY=change-me
R2_BUCKET=ashesborn-backups
